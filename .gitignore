# ==============================================================================
# Git Ignore Configuration for WhatyPie / Wapto Monorepo
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
node_modules
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.npm
.npm-cache
package-lock.json

# ------------------------------------------------------------------------------
# Build Outputs & Framework Caches
# ------------------------------------------------------------------------------
# Next.js
.next/
out/

# General Build Caches
build/
dist/
.cache/
.parcel-cache/
.turbo/

# TypeScript Cache & Auto-generated types
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Certificates and Keys
*.pem
*.key
*.crt

# ------------------------------------------------------------------------------
# Database, Backups & Runtime Storage
# ------------------------------------------------------------------------------
# MongoDB local database volume and dumps
.mongodb_data/
.mongo_dump_dir/

# Runtime uploads and storage
uploads/
storage/

# WhatsApp Baileys session authentication & tokens
auth_info_baileys/
auth/

# Process and runtime files
pids
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------------
# Local Development / Redundant Working Directories
# ------------------------------------------------------------------------------
# Local WhatyPie runtime/build copies (monorepo source is in Wapto-*/)
WhatyPie-admin/
WhatyPie-api/
WhatyPie-frontend/

# ------------------------------------------------------------------------------
# Logs & Debugging
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Testing & Code Coverage
# ------------------------------------------------------------------------------
coverage/
*.lcov
.nyc_output/

# ------------------------------------------------------------------------------
# Operating System & Editor Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs & Editors
.idea/
.vscode/
*.swp
*.swo
*~